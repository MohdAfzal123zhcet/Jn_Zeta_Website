{
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/evilock", "destination": "/evilock.html" },
    { "source": "/evilock/privacy", "destination": "/evilock-privacy.html" }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)\\.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"EviLock.apk\"" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
